# Copie este arquivo para .env.local e preencha. Nunca coloque chaves secretas no código.

# Supabase (Project Settings → API). A chave "publishable"/"anon" pode ir para o navegador:
# a segurança vem das regras RLS do banco, não do segredo desta chave.
NEXT_PUBLIC_SUPABASE_URL=https://bvalmgyqeikznasqydbr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sem as duas variáveis acima, o app abre em "modo demonstração" com dados fictícios guardados só neste aparelho.

# Não usamos a chave service_role. Se um dia for necessária, ela fica só no servidor (sem o prefixo NEXT_PUBLIC_).
